// =====================================================================
// Calculated columns
// Report date is fixed at 31 Oct 2026 because the data is a snapshot.
// With live data, replace DATE(2026, 10, 31) with TODAY().
// =====================================================================

// ---------- Table: Fees  (Table view → Fees → New column) ----------

Paid = SUMX(RELATEDTABLE(Payments), Payments[AmountPaid]) + 0

Balance = Fees[Amount] - Fees[Paid]

Status =
SWITCH(TRUE(),
    Fees[Balance] < 0, "Overpaid",
    Fees[Balance] = 0, "Paid",
    Fees[DueDate] < DATE(2026, 10, 31), "Overdue",
    "Not yet due")

DaysOverdue =
IF(Fees[Status] = "Overdue", DATEDIFF(Fees[DueDate], DATE(2026, 10, 31), DAY))

Ageing =
SWITCH(TRUE(),
    Fees[Status] <> "Overdue", BLANK(),
    Fees[DaysOverdue] <= 30, "1. 0–30 days",
    Fees[DaysOverdue] <= 90, "2. 31–90 days",
    Fees[DaysOverdue] <= 180, "3. 91–180 days",
    "4. Over 180 days")


// ---------- Table: Payments  (Table view → Payments → New column) ----------
// Applies the five policy rules from the About sheet.
// Each payment is labelled with the FIRST rule it breaks.

Exception =
VAR f = Payments[FeeID]
VAR a = Payments[AmountPaid]
VAR sameFeeSameAmount =
    COUNTROWS(
        FILTER(
            ALL(Payments[PaymentID], Payments[FeeID], Payments[AmountPaid]),
            Payments[FeeID] = f && Payments[AmountPaid] = a))
RETURN
SWITCH(TRUE(),
    sameFeeSameAmount > 1, "Possible duplicate",
    a > RELATED(Fees[Amount]), "Overpayment",
    Payments[PaymentDate] > DATE(2026, 10, 31), "Future-dated",
    ISBLANK(Payments[ReceiptNo]), "Missing receipt",
    Payments[Method] = "Cash" && a > 15000, "Large cash payment",
    "None")
